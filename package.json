{
  "name": "ghostly-multisig",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pass a multisig PSBT between co-signers in a chat: a Ghostly mini-app that builds to one self-contained HTML file.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "check:bundle": "node scripts/bundle.mjs",
    "dev": "vite",
    "digest": "node scripts/digest.mjs",
    "gen:icon": "node scripts/icon.mjs",
    "stage": "node scripts/stage.mjs",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/btc-signer": "2.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.2",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.0.3"
  },
  "overrides": {
    "rolldown": "1.2.12"
  }
}
